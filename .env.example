# Copy the URI from Supabase Connect (session pooler or direct connection).
# Use postgresql+psycopg:// and append ?sslmode=require. Never commit the real URI.
DATABASE_URL=
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
# Reserved for future collectors; not required for the foundation.
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=
XHH_REQUEST_DELAY_SECONDS=3
XHH_PUBLIC_FEED_URL=https://xiaoheihe.cn/
# Optional JSON list of public post URLs; keep this limited and policy-compliant.
XHH_PUBLIC_POST_URLS=[]
NEWS_COLLECTION_INTERVAL=3600
STOCK_COLLECTION_INTERVAL=3600
